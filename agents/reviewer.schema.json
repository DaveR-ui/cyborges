{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewerOutput",
  "description": "Structured return for the reviewer subagent: verdict, per-finding issues, and a free-form summary report.",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "request_changes",
        "block"
      ],
      "description": "Overall review verdict."
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "Path of the file containing the issue."
          },
          "line": {
            "type": "integer",
            "description": "Line number of the issue."
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "warning",
              "info"
            ],
            "description": "Severity of the issue."
          },
          "message": {
            "type": "string",
            "description": "What is wrong and how to fix it."
          }
        },
        "required": [
          "file",
          "line",
          "severity",
          "message"
        ],
        "additionalProperties": false
      },
      "description": "Per-finding issues discovered during review."
    },
    "summary": {
      "type": "string",
      "description": "Free-form review report."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Calibrated confidence in this return (0 = no confidence, 1 = certain)."
    }
  },
  "required": [
    "verdict",
    "issues",
    "summary",
    "confidence"
  ],
  "additionalProperties": false
}
